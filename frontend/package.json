{
  "name": "zzik-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test",
    "dev:demo": "vite --mode demo --host 127.0.0.1 --port 5174 --strictPort",
    "build:demo": "tsc -b && vite build --mode demo",
    "test:demo": "playwright test --config playwright.demo.config.ts",
    "types:generate": "node ../contracts/codegen/generate.mjs",
    "types:check": "node ../contracts/codegen/generate.mjs --check"
  },
  "dependencies": {
    "@tanstack/react-query": "5.103.0",
    "fflate": "0.8.3",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0"
  }
}
